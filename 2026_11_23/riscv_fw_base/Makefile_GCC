
#using mysys sdk
CODIX_BASE_PATH = /c/msys64/ucrt64/riscv32-unknown-elf
CODIX_BERKELIUM_PATH=$(CODIX_BASE_PATH)

CODIX_CC = riscv32-unknown-elf-gcc
CODIX_ASM = riscv32-unknown-elf-as
CODIX_LD = riscv32-unknown-elf-ld
CODIX_OBJCOPY = riscv32-unknown-elf-objcopy
CODIX_OBJDUMP = riscv32-unknown-elf-objdump

RISCV_ARCH = rv32imc_zicsr
RISCV_ABI = ilp32
LIBC_DIR := $(dir $(shell $(CODIX_CC) -march=$(RISCV_ARCH) -mabi=$(RISCV_ABI) -print-file-name=libc.a))
LIBGCC_DIR := $(dir $(shell $(CODIX_CC) -march=$(RISCV_ARCH) -mabi=$(RISCV_ABI) -print-libgcc-file-name))
LIBNOSYS_DIR := $(dir $(shell $(CODIX_CC) -march=$(RISCV_ARCH) -mabi=$(RISCV_ABI) -print-file-name=libnosys.a))

LDSFLAGS= -E -P

#using codix-bk3-32IMC-Upid-CORE-3.2.0-8.3.3-2901-windows.10.x86_64
#CODIX_BASE_PATH =  /C/Codasip/codix-bk3-32IMC-Upid-CORE-3.2.0-8.3.3-2901-windows.10.x86_64
#CODIX_BERKELIUM_PATH= $(CODIX_BASE_PATH)/sdk

#CODIX_CC = $(CODIX_BERKELIUM_PATH)/bin/bk3-32IMC-Upid-ia-clang
#CODIX_ASM = $(CODIX_BERKELIUM_PATH)/bin/bk3-32IMC-Upid-ia-assembler
#CODIX_LD = $(CODIX_BERKELIUM_PATH)/bin/bk3-32IMC-Upid-ia-ld
#CODIX_OBJCOPY = $(CODIX_BERKELIUM_PATH)/bin/bk3-32IMC-Upid-ia-objcopy
#CODIX_OBJDUMP = $(CODIX_BERKELIUM_PATH)/bin/bk3-32IMC-Upid-ia-objdump

INCLUDE = $(addprefix -I, $(wildcard ./inc/))
INCLUDE += -I./inc/lms
OUTPUT = ./output

vpath %.c ./source ./debug ./source/lms
vpath %.S ./source

OBJS=crt0.o \
	flash_cmd.o \
	flash_verify.o \
	cmd_sys.o \
	cmd_sys_def.o \
	cmdline.o \
	custom_test.o \
	custom_test_def.o \
	main.o \
	mcu.o \
	printf.o \
	reg_acc.o \
	timer.o \
	uart_int.o \
	spi.o \
	pff.o \
	mmcbbp.o \
	axi_brdg.o \
	lmk04906.o \
	i2c_master.o \
	dptx_co3.o \
	vbist.o \
	dp_phy.o \
	debug.o 

OBJS += $(notdir $(patsubst %.c,%.o,$(wildcard ./source/lms/*.c)))

#CFLAGS= -Os -Wall -march=rv32im
CFLAGS= -O0 -g3 -Wall
CFLAGS += -DLMS_VERIFY_ONLY=1
CFLAGS += -march=$(RISCV_ARCH) -mabi=$(RISCV_ABI)
CFLAGS += $(INCLUDE)


all: $(OBJS)
	$(CODIX_CC) $(LDSFLAGS) -x c default.lds -o default_new.lds
#	$(CODIX_LD) $(addprefix $(OUTPUT)/, ${OBJS}) -v -o $(OUTPUT)/test.xexe -T default.lds -L$(CODIX_BERKELIUM_PATH)/lib -L$(CODIX_BERKELIUM_PATH)/newlib/lib -lc -lcomp -Map $(OUTPUT)/test.map
	$(CODIX_LD) $(addprefix $(OUTPUT)/, ${OBJS}) -v -o $(OUTPUT)/test.xexe -T default_new.lds \
	-L$(LIBC_DIR) -L$(LIBGCC_DIR) -L$(LIBNOSYS_DIR) \
	-lc -lgcc -lnosys \
	-Map $(OUTPUT)/test.map

	$(CODIX_OBJCOPY) -j .imcode.crt0 -j .imcode.text -j .imcode.rodata -j .dmdata.data \
		-j .ctors -j .dtors -j .rodata -j .data -j .sdata -j .sbss \
		-j .text -j .init -j .fini -j .smcode.text -j .smdata.data \
		-O ihex $(OUTPUT)/test.xexe $(OUTPUT)/test.ihex
	

	$(CODIX_OBJDUMP) -D $(OUTPUT)/test.xexe > $(OUTPUT)/test.s
	@python mapanalysis.py

$(OUTPUT):
		@echo "Create directory $@ ..."
		mkdir -p $(OUTPUT)

.c.o:
	$(CODIX_CC) -c $< -o $(OUTPUT)/$@ $(CFLAGS)

.S.o:
	$(CODIX_ASM) $< -o $(OUTPUT)/$@ -march=$(RISCV_ARCH) -mabi=$(RISCV_ABI) -w

clean:
	rm -f test.* *.o
	rm -f *.i *.s *.bc *.o *.xexe *hex sim_exit_code cycles $(OUTPUT)/*
